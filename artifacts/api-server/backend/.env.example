# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# OpenAI API key — required for Whisper transcription and GPT analysis.
OPENAI_API_KEY=sk-...

# Models. Override if you want to use different OpenAI models.
WHISPER_MODEL=whisper-1
ANALYSIS_MODEL=gpt-4o-mini

# Optional: Deepgram for speaker diarization. When set, long-capture
# transcription routes through Deepgram instead of Whisper and produces
# speaker-labeled transcripts that the GPT analysis prompt can use.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# STT provider selection. 'auto' picks Deepgram if its key is set, else Whisper.
# Force a specific provider with 'whisper' or 'deepgram'.
STT_PROVIDER=auto

# Database. Default is local SQLite; swap for Postgres in production.
DATABASE_URL=sqlite:///./data/booth.db

# Where uploaded audio files are stored on disk.
AUDIO_DIR=./data/audio

# Max audio file size in MB. OpenAI Whisper limit is 25 MB per request.
MAX_AUDIO_MB=25

# Event metadata — surfaced in the booth UI and saved with each lead.
EVENT_NAME=Demo Conference 2026
BOOTH_NAME=Booth A1

# CORS origins for the frontend. Comma-separated. Use * only in dev.
CORS_ORIGINS=*

# Auth. Set a long random string (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`).
# If left blank, a random secret is generated at startup — but then every
# server restart invalidates all existing tokens (everyone is logged out),
# and it won't work across multiple worker processes. Always set this for
# anything beyond local single-process dev.
AUTH_SECRET=
# How long a login stays valid, in hours. 168 = 7 days (spans a multi-day event).
AUTH_TOKEN_TTL_HOURS=168

# "Sign in with Google" — optional. Create an OAuth 2.0 Client (Web
# application) in Google Cloud Console, add
#   <PUBLIC_BASE_URL>/api/auth/google/callback
# as an authorized redirect URI, and set PUBLIC_BASE_URL below plus either
# pair of client credentials. GOOGLE_LOGIN_* takes priority; if left blank it
# falls back to GOOGLE_CLIENT_ID/SECRET (the Google Meet integration's
# client) — one Google Cloud OAuth client can serve both, since each
# authorize request only asks for its own scopes.
PUBLIC_BASE_URL=
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
